[Unit]
# The monitor watches other hosts — it must run independently of all of them.
Description=Service Monitor (monitor-server)
After=network-online.target
Wants=network-online.target
# The store and the snapshot may live on a volume that attaches after boot: don't start
# against a bare mountpoint (the server also refuses a missing or empty store, D-015).
RequiresMountsFor=/opt/smon/data /opt/smon/status
# Restart policy (with the backoff in [Service]): a slow dependency keeps being retried and
# recovers on its own; a deterministic crash is retried at most every 10 minutes instead
# of every few seconds. With the backoff, 10 starts in 30 minutes is out of reach. On
# systemd < 254 (no RestartSteps) the fixed 15 s delay reaches it after ~2.5 minutes of
# failures and the unit is left `failed` ("start request repeated too quickly"); then fix
# the cause and `systemctl reset-failed monitor-server && systemctl start monitor-server`.
# Either way the public heartbeat expires, so the status page says "monitoring unavailable".
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=simple
# A dedicated system account, never root: the process parses responses from the network
# and holds alert credentials. It owns only data/ and status/ (deploy/RUNBOOK.md, Install);
# releases/ and env stay root-owned, so it cannot rewrite its own binary or config.
# systemd reads EnvironmentFile as root before dropping to this user, so env can be 0600.
User=smon
Group=smon
EnvironmentFile=/opt/smon/env
ExecStart=/opt/smon/current/bin/monitor-server
Restart=on-failure
# Back off 15 s → 10 min over 8 steps (systemd ≥ 254; older versions log and ignore the
# two Step/Max keys and keep the fixed 15 s).
RestartSec=15s
RestartSteps=8
RestartMaxDelaySec=600s
# Stop sends SIGTERM (the server drains: HTTP <= 12 s, engine <= 15 s), then SIGKILL after
# this — longer than the drain, so a graceful stop is never cut short.
TimeoutStopSec=40s
# Hard stops consistent with the project's own bounds: the store is byte-capped by
# SMON_MAX_DB_BYTES, logs by SMON_LOG_MAX_BYTES; the kernel adds its own here.
LimitNOFILE=4096
MemoryMax=512M
# Sandboxing: no capabilities (58400 is an unprivileged port), no privilege gain, a
# read-only system except the two directories the monitor writes.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/smon/data /opt/smon/status

[Install]
WantedBy=multi-user.target
