# /opt/smon/env for the SFO3 droplet (deploy/droplet/DEPLOY.md). The admin token is appended
# by the deploy steps (generated there, root-only 0600); fill alert channels only if used.
# Every setting is parsed strictly at boot — an invalid value stops the boot and names itself.

SMON_DATABASE_URL=sqlite:/opt/smon/data/monitor.db
SMON_LISTEN=127.0.0.1:58400
SMON_DASHBOARD_DIR=/opt/smon/current/dashboard
SMON_STATUS_DIR=/opt/smon/status
SMON_BACKUP_DIR=/opt/smon/data/backups
SMON_MAX_DB_BYTES=2147483648

# Caddy on this host is the only proxy the server sees; it already attributes visitors over
# Cloudflare's trusted ranges (cloudflare-ips.sh). Every dashboard request arrives over TLS.
SMON_TRUSTED_PROXY=127.0.0.1
SMON_COOKIE_SECURE=always

# Alert channels — all or none per channel. Webhook: the URL is operator configuration and
# is deliberately not SSRF-guarded (D-017). SMTP: prefer smtps:// (implicit TLS, no cleartext
# preamble); smtp://host:587?tls=required only where implicit TLS isn't offered.
# SMON_WEBHOOK_URL=
# SMON_WEBHOOK_SECRET=
# SMON_SMTP_DSN=smtps://user:pass@smtp.example.com:465
# SMON_SMTP_FROM=alerts@example.com
# SMON_SMTP_TO=oncall@example.com

# SMON_ADMIN_TOKEN is appended by DEPLOY.md step 3 (openssl rand -hex 32).
