<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shirase.smon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -a; . /opt/smon/env; set +a; exec /opt/smon/current/bin/monitor-server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Stop sends SIGTERM, then SIGKILL after this many seconds. The server drains HTTP
         for up to 12 s and the engine for up to 15 s; launchd's default is shorter. -->
    <key>ExitTimeOut</key>
    <integer>40</integer>
    <key>StandardOutPath</key>
    <string>/opt/smon/data/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/smon/data/stderr.log</string>
</dict>
</plist>
