{
  "name": "@service-monitor/dashboard",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Service Monitor's dashboard: a static SvelteKit app the Rust server can serve on its own origin.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "1.77.0",
    "bits-ui": "2.21.0",
    "cn": "^0.5.2",
    "mode-watcher": "1.1.0",
    "svelte-sonner": "1.2.3",
    "tailwind-variants": "4.0.2",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "shadcn-svelte": "1.8.1",
    "svelte": "5.59.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
