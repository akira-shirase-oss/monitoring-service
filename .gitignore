# OS and editor files
.DS_Store
*.swp
.idea/
.vscode/

# Rust
/target/
# The detached fuzz package's own target dir
fuzz/target/

# Node / SvelteKit
node_modules/
.svelte-kit/
build/
dist/

# Local environment and secrets
.env
.env.*
!.env.example

# Local runtime data: the SQLite database and its WAL sidecars
*.db
*.db-shm
*.db-wal
/var/
# The snapshot writer's default SMON_STATUS_DIR (relative to the repo root). Anchored:
# an unanchored `status/` also matched apps/dashboard/src/routes/status/ and hid it.
/status/
apps/dashboard/test-results/
apps/dashboard/playwright-report/

# cargo-mutants working dirs (transient — evidence lands in perf/results/)
mutants.out*/
perf/tmp/

# Fuzz crash reproducers — evidence, reviewed and committed deliberately, never silently.
fuzz/artifacts/
